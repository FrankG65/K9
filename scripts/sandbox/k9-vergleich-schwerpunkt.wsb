<!--
  Vergleichstest SCHWERPUNKT: Datendiebe und Ransomware werden GESTARTET (sandbox-vergleich.ps1
  -Schwerpunkt), vorher legt das Skript Koeder an (Schein-Browserprofile, Schein-Dokumente).
  Kein beschreibbarer Ordner zum PC: Ergebnisse bleiben in der Sandbox (Bildschirmfoto). Netzwerk
  an, weil die Sandbox die Proben selbst laedt; das Skript sperrt das Netzwerk dreifach, BEVOR es
  entpackt, und prueft das vor und nach jeder Probe. Der Testordner ist nur lesbar. Nur mit Zustimmung
  des Nutzers fuer genau diesen Tag: testlabor\sandbox\vergleich\ZUSTIMMUNG.txt mit dem Datum und
  den Zeilen "starten" und "ransomware". Siehe docs\SANDBOX-TESTPLAN.md.
-->
<Configuration>
  <vGPU>Disable</vGPU>
  <Networking>Enable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ProtectedClient>Enable</ProtectedClient>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\K9-Quelltext\testlabor\sandbox</HostFolder>
      <SandboxFolder>C:\Testlabor</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "K9-Vergleichstest Schwerpunkt (Datendiebe und Ransomware werden gestartet)" powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\Testlabor\sandbox-vergleich.ps1 -Anzahl 20 -Schwerpunkt</Command>
  </LogonCommand>
</Configuration>
