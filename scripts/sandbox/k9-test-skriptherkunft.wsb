<!--
  Test "Skript aus dem Internet gestartet" (sandbox-test-skriptherkunft.ps1). Ohne Netzwerk,
  nur harmlose Skripte, keine Schadsoftware. Der Test startet von selbst in einem sichtbaren
  Fenster (etwa 4 Minuten). Ergebnisse: Dokumente\Virenscanner-Sandbox-Ergebnis\skriptherkunft.
  Siehe docs\SANDBOX-TESTPLAN.md.
-->
<Configuration>
  <vGPU>Disable</vGPU>
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ProtectedClient>Enable</ProtectedClient>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\K9-Quelltext\testlabor\sandbox</HostFolder>
      <SandboxFolder>C:\Testlabor</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\anna\Documents\Virenscanner-Sandbox-Ergebnis</HostFolder>
      <SandboxFolder>C:\Ergebnis</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "K9-Test: Skript aus dem Internet (harmlos)" powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\Testlabor\sandbox-test-skriptherkunft.ps1</Command>
  </LogonCommand>
</Configuration>
