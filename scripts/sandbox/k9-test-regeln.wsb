<!--
  Test "Regeln fuer Programmstarts" (sandbox-test-regeln.ps1). Ohne Netzwerk, keine
  Schadsoftware: Windows-eigene Programme mit Befehlszeilen, wie Angreifer sie benutzen, aber
  ohne Wirkung. Der Test startet von selbst in einem sichtbaren Fenster (etwa 10 Minuten) und
  schliesst die Sandbox am Ende. Ergebnisse: Dokumente\Virenscanner-Sandbox-Ergebnis\regeln.
-->
<Configuration>
  <vGPU>Disable</vGPU>
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ProtectedClient>Enable</ProtectedClient>
  <MemoryInMB>4096</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\K9-Quelltext\testlabor\sandbox</HostFolder>
      <SandboxFolder>C:\Testlabor</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\anna\Documents\Virenscanner-Sandbox-Ergebnis</HostFolder>
      <SandboxFolder>C:\Ergebnis</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd.exe /c start "K9-Test: Regeln fuer Programmstarts (harmlos)" powershell.exe -NoExit -ExecutionPolicy Bypass -File C:\Testlabor\sandbox-test-regeln.ps1</Command>
  </LogonCommand>
</Configuration>
